pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Verificar entorno') {
            steps {
                dir('wdio-allure') {
                    bat 'node -v'
                    bat 'npm -v'
                }
            }
        }

        stage('Instalar dependencias') {
            steps {
                dir('wdio-allure') {
                    bat 'npm ci'
                }
            }
        }

        stage('Limpiar resultados anteriores') {
            steps {
                dir('wdio-allure') {
                    bat 'npm run clean:allure'
                }
            }
        }

        stage('Ejecutar WDIO') {
            steps {
                echo 'Ejecutando pruebas WDIO...'
                dir('wdio-allure') {
                    bat 'npx wdio run wdio.conf.js'
                }
            }
        }
    }

    post {
        always {
            echo 'Publicando reporte Allure...'
            allure([
                includeProperties: false,
                jdk: '',
                commandline: 'allure',
                results: [[path: 'wdio-allure/allure-results']],
                reportBuildPolicy: 'ALWAYS'
            ])
        }
        success {
            echo 'Pruebas ejecutadas con éxito.'
        }
        failure {
            echo 'Falló alguna etapa del pipeline.'
        }
    }
}